WEBHOOK_SHARED_TOKEN=replace_me_with_long_random_secret
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=replace_me
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_TARGETS_FILE=/runtime/feishu-targets.toml
FEISHU_TARGET_RELOAD_INTERVAL_SECONDS=10
CONFIG_RELOAD_TOKEN=replace_me_with_admin_reload_token
HOST=0.0.0.0
PORT=2398
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=10
TOKEN_REFRESH_SKEW_SECONDS=300

# Legacy single-target compatibility mode only:
# FEISHU_APP_TOKEN=bascn_xxx
# FEISHU_TABLE_ID=tblxxx
# FEISHU_RECORD_ID=recxxxxxxxxxxxxxx
# FEISHU_ORIGINAL_FIELD_NAME=原始信息

# AI extraction pipeline / AI 提取管线
# All AI_* vars are optional when AI_ENABLED=false.
# See docs/ai-pipeline.md (中文) or docs/en/ai-pipeline.md (English) for full config.
#AI_ENABLED=true
#AI_PROVIDER=anthropic                # "anthropic" or "openai"
#AI_API_KEY=sk-xxx
#AI_MODEL=claude-3-5-sonnet-20241022
# AI_BASE_URL concatenation rule (easy to get wrong):
#   anthropic: base EXCLUDES /v1, service appends /v1/messages
#              official default https://api.anthropic.com (leave empty)
#              relay example:    https://your-relay.example.com   (NO /v1)
#   openai:    base INCLUDES /v1, service appends /chat/completions
#              official default https://api.openai.com/v1 (leave empty)
#              relay example:    https://your-relay.example.com/v1
#AI_BASE_URL=https://api.anthropic.com
#AI_TIMEOUT_SECONDS=20
#AI_PROFILE_FILE=/runtime/ai-profile.toml
#AI_PROFILE_RELOAD_INTERVAL_SECONDS=10
#AI_DEDUP_TTL_SECONDS=300
